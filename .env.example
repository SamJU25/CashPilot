[TEMPLATE]
# SME Finance Copilot — Environment Configuration Template
# Copy to .env and adjust values for your environment.

# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# API Ingress & Limits
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
MAX_ANALYSIS_UPLOAD_BYTES=10485760
# Per-IP token bucket. Default 60; set 0 to disable (never disable in production).
RATE_LIMIT_PER_MINUTE=60
# Number of trusted reverse proxies appending X-Forwarded-For (0 when directly exposed).
# Set this to the real hop count; the limiter trusts only the rightmost entries.
TRUSTED_PROXY_HOPS=0

# Security & CORS (comma-separated origins for production)
ALLOWED_ORIGINS=http://localhost:3000

# Tenant authentication
# TENANT_TOKEN_SECRET signs tenant tokens. Required in any shared/deployed environment;
# when unset the server generates a random per-process secret (tokens die on restart).
TENANT_TOKEN_SECRET=
# Enrollment key required by POST /api/v1/auth/token so identities cannot be self-asserted.
TENANT_ENROLLMENT_KEY=
# Bind the single enrollment key to one tenant (required unless you use the per-tenant map).
# An unbound single key is fail-closed.
TENANT_ENROLLMENT_TENANT_ID=
# Local-development escape hatch only: allow an unbound single key to mint any tenant.
# TENANT_ENROLLMENT_ALLOW_ANY_TENANT=1
# Multi-tenant alternative: JSON map of tenant_id -> enrollment key.
# TENANT_ENROLLMENT_KEYS={"SME-COFFEE-001":"change-me","SME-ACME-002":"change-me-too"}
# Operator key for process-wide admin operations such as POST /api/v1/decision/reload.
# When unset, those endpoints return 503 instead of accepting anonymous callers.
DECISION_ADMIN_KEY=

# Tier 2 queue hygiene: pending proposals expire, and repeated identical instructions
# reuse the existing proposal inside the dedupe window.
STAGED_INTENT_TTL_HOURS=72
STAGED_INTENT_DEDUPE_SECONDS=300

# Outbound LLM endpoint policy (SSRF guard, services/agent/url_guard.py)
# Leave at 0 unless you are intentionally pointing at a self-hosted model on localhost/RFC1918.
LLM_ALLOW_LOOPBACK_ENDPOINTS=0
LLM_ALLOW_PRIVATE_ENDPOINTS=0

# Deployment label. Set to production/staging to make COPILOT_DATA_KEY mandatory at startup;
# local (the default) allows plaintext stores for development.
COPILOT_ENV=local

# Encryption at rest for .sessions/ and .data/ (required when COPILOT_ENV is production/staging).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COPILOT_DATA_KEY=

# Tier 3 passkeys: RP ID must be the page host (no port); origins must match the browser URL exactly
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SME Finance Copilot
WEBAUTHN_ORIGINS=http://localhost:3000
